# --- Firebase (클라이언트, 공개 가능) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (서버 전용, 절대 공개 금지) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# 서비스 계정 private_key 값. 줄바꿈은 \n 문자 그대로 두고 큰따옴표로 감싼다.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- 관리자 화이트리스트 (1인) ---
ADMIN_EMAIL=
# 선택: 첫 로그인 후 /admin 대시보드에 표시되는 UID를 넣으면 이중 검증
ADMIN_UID=

# --- 세션 ---
# 세션 쿠키 유효기간(일). Firebase 허용 범위 1시간~14일
ADMIN_SESSION_DAYS=5

# --- 사이트 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 이후 마일스톤(M3 댓글, M5 통계) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
IP_HASH_SALT=

# Storage(Blaze) 활성화 후 true 로 변경
NEXT_PUBLIC_UPLOADS_ENABLED=false
