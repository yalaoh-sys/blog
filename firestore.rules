rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 모든 쓰기는 서버(Admin SDK)만 가능 — 클라이언트 쓰기 전면 차단
    match /posts/{id} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }
    match /categories/{id} {
      allow read: if resource.data.visible == true;
      allow write: if false;
    }
    match /siteSettings/{id} { allow read: if true; allow write: if false; }
    match /homeLayout/{id}   { allow read: if true; allow write: if false; }
    match /profile/{id}      { allow read: if true; allow write: if false; }

    // passwordHash/ipHash 등 민감 데이터 — 서버 API 경유만
    match /comments/{id}  { allow read, write: if false; }
    match /media/{id}     { allow read, write: if false; }
    match /redirects/{id} { allow read, write: if false; }
    match /events/{id}    { allow read, write: if false; }
    match /stats_daily/{document=**} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
